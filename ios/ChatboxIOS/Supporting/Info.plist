<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>zh_CN</string>
  <key>CFBundleDisplayName</key><string>DeepSeek Chatbox</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key><string>com.dsbox.chatbox</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.12.4</string>
  <key>CFBundleVersion</key><string>87</string>
  <key>LSRequiresIPhoneOS</key><true/>
  <key>UILaunchScreen</key><dict/>
  <key>UIRequiredDeviceCapabilities</key><array><string>arm64</string></array>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <key>UIAppFonts</key><array/>
  <key>ITSAppUsesNonExemptEncryption</key><false/>
  <key>NSCameraUsageDescription</key>
  <string>拍照后作为附件发送给模型</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>按住说话时录制语音，转成文字后发送</string>
  <key>NSPhotoLibraryUsageDescription</key>
  <string>从相册选择图片作为附件发送</string>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key><false/>
    <key>NSExceptionDomains</key>
    <dict>
      <key>api.deepseek.com</key>
      <dict>
        <key>NSExceptionRequiresForwardSecrecy</key><false/>
      </dict>
    </dict>
  </dict>
</dict>
</plist>
